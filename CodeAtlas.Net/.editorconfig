# C# style that src/ and tests/ follow. Directory.Build.props sets EnforceCodeStyleInBuild and
# TreatWarningsAsErrors, so every rule at warning below fails `dotnet build`.
#
# Indentation and brace placement are editor settings only. The formatting rule IDE0055 would check
# them, but it also rewrites what the code does on purpose: several initializer members or switch arms on
# one line, and initializer braces both on their own line and after `new`. With any brace setting it
# reformats about 550 lines in 60 files, so it stays off. See CODING_STANDARDS.md.
root = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4

# File-scoped namespaces (IDE0161).
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# Naming (IDE1006). Roslyn applies the most specific matching rule first.
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.interface_prefix.capitalization = pascal_case
dotnet_naming_style.interface_prefix.required_prefix = I

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = interface_prefix
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_symbols.types_and_members.applicable_kinds = namespace, class, struct, enum, delegate, method, local_function, property, event
dotnet_naming_symbols.types_and_members.applicable_accessibilities = *
dotnet_naming_rule.types_and_members_are_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_and_members_are_pascal_case.style = pascal_case
dotnet_naming_rule.types_and_members_are_pascal_case.severity = warning

# Constants and static readonly fields read like members: PascalCase.
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_rule.constant_fields_are_pascal_case.symbols = constant_fields
dotnet_naming_rule.constant_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.constant_fields_are_pascal_case.severity = warning

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_rule.static_readonly_fields_are_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_fields_are_pascal_case.severity = warning

# Fields visible outside their type (interop structs, test counters): PascalCase.
dotnet_naming_symbols.visible_fields.applicable_kinds = field
dotnet_naming_symbols.visible_fields.applicable_accessibilities = public, internal, protected, protected_internal, private_protected
dotnet_naming_rule.visible_fields_are_pascal_case.symbols = visible_fields
dotnet_naming_rule.visible_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.visible_fields_are_pascal_case.severity = warning

# Private fields, parameters and locals: camelCase, no prefix.
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_are_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_camel_case.style = camel_case
dotnet_naming_rule.private_fields_are_camel_case.severity = warning

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_rule.parameters_and_locals_are_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_are_camel_case.style = camel_case
dotnet_naming_rule.parameters_and_locals_are_camel_case.severity = warning
