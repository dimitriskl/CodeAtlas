{
  "id": "change-changepassword-cancellation",
  "kind": "change",
  "title": "Add a CancellationToken to IUserManager.ChangePassword",
  "prompt": "Add a CancellationToken parameter named cancellationToken, without a default value, as the last parameter of IUserManager.ChangePassword(Guid userId, string newPassword). Update its implementation so the token is used, and update every caller: pass an available token where one exists, otherwise CancellationToken.None. Do not keep an overload with the old signature. Do not change IAuthenticationProvider.ChangePassword or its implementations. The solution, including tests, must build.",
  "answer": false,
  "checks": [
    {
      "type": "regex",
      "path": "MediaBrowser.Controller/Library/IUserManager.cs",
      "expect": "present",
      "pristine": false,
      "pattern": "Task\\s+ChangePassword\\(\\s*Guid\\s+\\w+\\s*,\\s*string\\s+\\w+\\s*,\\s*(System\\.Threading\\.)?CancellationToken\\s+cancellationToken\\s*\\)\\s*;"
    },
    {
      "type": "regex",
      "path": "MediaBrowser.Controller/Library/IUserManager.cs",
      "expect": "absent",
      "pristine": false,
      "pattern": "Task\\s+ChangePassword\\(\\s*Guid\\s+\\w+\\s*,\\s*string\\s+\\w+\\s*\\)"
    },
    {
      "type": "regex",
      "path": "Jellyfin.Server.Implementations/Users/UserManager.cs",
      "expect": "present",
      "pristine": false,
      "pattern": "Task\\s+ChangePassword\\(\\s*Guid\\s+\\w+\\s*,\\s*string\\s+\\w+\\s*,\\s*(System\\.Threading\\.)?CancellationToken\\s+cancellationToken\\s*\\)"
    },
    {
      "type": "regex",
      "path": "MediaBrowser.Controller/Authentication/IAuthenticationProvider.cs",
      "expect": "present",
      "pristine": true,
      "pattern": "Task ChangePassword\\(User user, string newPassword\\);"
    },
    {
      "type": "regex",
      "path": "Jellyfin.Server.Implementations/Users/DefaultAuthenticationProvider.cs",
      "expect": "present",
      "pristine": true,
      "pattern": "public Task ChangePassword\\(User user, string newPassword\\)"
    },
    {
      "type": "regex",
      "path": "Jellyfin.Server.Implementations/Users/InvalidAuthProvider.cs",
      "expect": "present",
      "pristine": true,
      "pattern": "public Task ChangePassword\\(User user, string newPassword\\)"
    },
    {
      "type": "command",
      "name": "build",
      "argv": ["dotnet", "build", "Jellyfin.sln", "--no-restore", "-nologo", "-v:q"],
      "timeoutSeconds": 900
    }
  ],
  "reference": {
    "patch": "reference/change-changepassword-cancellation.patch"
  }
}
