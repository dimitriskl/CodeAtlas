<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage for the CRAP gate (scripts/crap-gate.py), collected in the full test step of qualify-package.py. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Format>Cobertura</Format>
          <CodeCoverage>
            <!-- Tests run the CLI in-process and as child processes from src/CodeAtlas.Cli/bin. Dynamic
                 instrumentation covers both; static instrumentation of the test output folder lost the
                 in-process hits of codeatlas.dll on Linux. -->
            <EnableStaticManagedInstrumentation>False</EnableStaticManagedInstrumentation>
            <EnableDynamicManagedInstrumentation>True</EnableDynamicManagedInstrumentation>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
